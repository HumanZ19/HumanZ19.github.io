---
import type { Lang } from '@types';
import type { Profile } from '@types';
import { t } from '@utils/i18n';
import ExperienceCard from './ExperienceCard.astro';

interface Props {
  profile: Profile;
  lang: Lang;
}
const { profile, lang } = Astro.props;
---

<section id="experience" class="section border-b border-line-600">
  <div class="shell">
    <div class="section-head">
      <span class="section-index">01</span>
      <h2 class="section-title">{t('sections.experience', lang)}</h2>
      <span class="section-note">{profile.experience.length} {lang === 'fr' ? 'postes' : 'roles'}</span>
    </div>

    <p class="mb-12 max-w-2xl text-sm text-txt-300">
      {t('experience.subtitle', lang)}
    </p>

    <!--
      Colonne unique alignee sur un rail. L'alternance gauche/droite de
      l'ancienne version produisait des croisements a certaines largeurs :
      une seule colonne se lit mieux et ne peut pas se chevaucher.
    -->
    <div class="max-w-4xl">
      {
        profile.experience.map((exp, i) => (
          <ExperienceCard experience={exp} lang={lang} index={i} />
        ))
      }
    </div>
  </div>
</section>
