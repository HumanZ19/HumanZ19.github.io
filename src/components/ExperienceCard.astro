---
import type { Lang } from '@types';
import { t, localized, localizedArray } from '@utils/i18n';

interface Experience {
  company: string;
  position: { fr: string; en: string };
  startDate: string;
  endDate: string;
  summary: { fr: string; en: string };
  highlights: { fr: string[]; en: string[] };
  stack: string[];
}

interface Props {
  experience: Experience;
  lang: Lang;
  index: number;
}
const { experience, lang, index } = Astro.props;

const position = localized(experience.position, lang);
const summary = localized(experience.summary, lang);
const highlights = localizedArray(experience.highlights, lang);

const startYear = experience.startDate.split('-')[0];
const isActive = experience.endDate === 'Present';
const endYear = isActive ? t('experience.present', lang) : experience.endDate.split('-')[0];

const ref = String(index + 1).padStart(2, '0');
---

<article class="rail rail-mark relative pb-12 last:pb-0">
  <!-- En-tete : periode en monospace, poste en condensed -->
  <div class="flex flex-wrap items-baseline gap-x-4 gap-y-1">
    <span class="font-mono text-xs tracking-[0.08em] text-signal">{ref}</span>
    <span class="font-mono text-xs text-txt-500">{startYear} - {endYear}</span>
    {
      isActive && (
        <span class="tag tag-strong">{t('experience.present', lang)}</span>
      )
    }
  </div>

  <h3 class="mt-3 font-display text-xl font-semibold text-txt-100">
    {position}
  </h3>

  <p class="mt-1 font-mono text-xs uppercase tracking-[0.08em] text-txt-300">
    {experience.company}
  </p>

  <p class="mt-4 max-w-3xl text-sm text-txt-300">
    {summary}
  </p>

  <ul class="mt-5 max-w-3xl space-y-2">
    {
      highlights.map((h) => (
        <li class="flex gap-3 text-sm text-txt-300">
          <span class="mt-2 h-px w-3 flex-shrink-0 bg-signal-dim" aria-hidden="true" />
          <span>{h}</span>
        </li>
      ))
    }
  </ul>

  {
    experience.stack.length > 0 && (
      <div class="mt-6">
        <p class="label mb-2">{t('experience.stack_label', lang)}</p>
        <div class="tag-row">
          {experience.stack.map((tech) => (
            <span class="tag">{tech}</span>
          ))}
        </div>
      </div>
    )
  }
</article>
