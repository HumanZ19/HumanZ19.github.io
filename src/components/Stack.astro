---
import type { Lang } from '@types';
import type { Profile } from '@types';
import { t, localized } from '@utils/i18n';

interface Props {
  profile: Profile;
  lang: Lang;
}
const { profile, lang } = Astro.props;
const { technical } = profile.skills;
---

<section id="stack" class="section border-b border-line-600">
  <div class="shell">
    <div class="section-head">
      <span class="section-index">03</span>
      <h2 class="section-title">{t('sections.stack', lang)}</h2>
    </div>

    <div class="space-y-14">
      {
        technical.map((category) => (
          <div>
            <h3 class="label mb-6 border-b border-line-600 pb-2">{localized(category.category, lang)}</h3>

            <!--
              Jauge lineaire plutot que barre de progression arrondie : la
              lecture reste instrumentale et la hauteur de chaque ligne est
              fixe, ce qui garantit l'alignement de la grille.
            -->
            <div class="grid gap-x-8 gap-y-5 sm:grid-cols-2 lg:grid-cols-3">
              {category.items.map((skill) => (
                <div>
                  <div class="flex items-baseline justify-between gap-3">
                    <span class="truncate font-mono text-sm text-txt-100">{skill.name}</span>
                    <span class="flex-shrink-0 font-mono text-xs text-txt-500">{skill.level}</span>
                  </div>
                  <div
                    class="mt-2 h-1 w-full bg-ink-700"
                    role="progressbar"
                    aria-valuenow={skill.level}
                    aria-valuemin={0}
                    aria-valuemax={100}
                    aria-label={skill.name}
                  >
                    <div class="h-full bg-signal" style={`width:${skill.level}%`} />
                  </div>
                </div>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
