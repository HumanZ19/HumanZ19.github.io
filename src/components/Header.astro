---
import type { Lang } from '@types';
import { t } from '@utils/i18n';
import LanguageSwitch from './LanguageSwitch.astro';
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

const navLinks = [
  { key: 'nav.about', href: '#about' },
  { key: 'nav.experience', href: '#experience' },
  { key: 'nav.projects', href: '#projects' },
  { key: 'nav.stack', href: '#stack' },
  { key: 'nav.contact', href: '#contact' },
];
---

<!--
  [SPEC 5.2] header colle en haut plutot que fixe : il ne recouvre jamais un
  autre contenu et ne necessite aucune cale compensatoire.
-->
<header id="site-header" class="sticky top-0 z-10 border-b border-line-600 bg-ink-900/95 backdrop-blur">
  <div class="shell flex h-14 items-center justify-between gap-4">
    <a
      href={lang === 'fr' ? '/' : '/en/'}
      class="flex-shrink-0 font-mono text-xs uppercase tracking-[0.08em] text-txt-100 hover:text-signal"
    >
      K. AIT HAMMOU
    </a>

    <nav class="hidden items-center gap-6 md:flex" aria-label={lang === 'fr' ? 'Navigation' : 'Navigation'}>
      {
        navLinks.map(({ key, href }) => (
          <a href={href} class="font-mono text-xs uppercase tracking-[0.08em] text-txt-500 hover:text-txt-100">
            {t(key, lang)}
          </a>
        ))
      }
    </nav>

    <div class="flex flex-shrink-0 items-center gap-2">
      <ThemeToggle lang={lang} />
      <LanguageSwitch lang={lang} />

      <button
        id="mobile-menu-btn"
        aria-label="Menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
        class="flex h-8 w-8 items-center justify-center border border-line-500 text-txt-300 hover:border-txt-300 hover:text-txt-100 md:hidden"
      >
        <svg id="icon-hamburger" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <path stroke-linecap="square" d="M4 7h16M4 12h16M4 17h16"></path>
        </svg>
        <svg id="icon-close" class="hidden h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <path stroke-linecap="square" d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
    </div>
  </div>

  <div
    id="mobile-menu"
    class="hidden border-t border-line-600 bg-ink-800 md:hidden"
    role="navigation"
    aria-label={lang === 'fr' ? 'Navigation mobile' : 'Mobile navigation'}
  >
    <div class="shell flex flex-col py-2">
      {
        navLinks.map(({ key, href }) => (
          <a
            href={href}
            class="mobile-nav-link border-b border-line-600 py-3 font-mono text-xs uppercase tracking-[0.08em] text-txt-300 last:border-b-0 hover:text-signal"
          >
            {t(key, lang)}
          </a>
        ))
      }
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const iconHamburger = document.getElementById('icon-hamburger');
  const iconClose = document.getElementById('icon-close');

  function closeMenu() {
    menu?.classList.add('hidden');
    btn?.setAttribute('aria-expanded', 'false');
    iconHamburger?.classList.remove('hidden');
    iconClose?.classList.add('hidden');
  }

  btn?.addEventListener('click', () => {
    const isHidden = menu?.classList.toggle('hidden');
    btn.setAttribute('aria-expanded', String(!isHidden));
    iconHamburger?.classList.toggle('hidden');
    iconClose?.classList.toggle('hidden');
  });

  document.querySelectorAll('.mobile-nav-link').forEach((link) => {
    link.addEventListener('click', closeMenu);
  });
</script>
