---
import type { Lang } from '@types';
import type { Projects } from '@types';
import { t, localized } from '@utils/i18n';

interface Props {
  projects: Projects;
  lang: Lang;
}
const { projects, lang } = Astro.props;

const testimonials = projects.projects
  .filter((p) => p.testimonial)
  .map((p) => ({
    text: localized(p.testimonial!.text, lang),
    author: p.testimonial!.author,
    project: p.title,
  }));
---

{
  testimonials.length > 0 && (
    <section id="testimonials" class="section border-b border-line-600">
      <div class="shell">
        <div class="section-head">
          <span class="section-index">05</span>
          <h2 class="section-title">{t('sections.testimonials', lang)}</h2>
          <span class="section-note">
            {testimonials.length} {lang === 'fr' ? 'retours' : 'entries'}
          </span>
        </div>

        {/* Grille statique plutot qu'un carrousel : rien ne se superpose,
            rien ne bouge, et tout reste lisible sans interaction. */}
        <div class="grid items-stretch gap-6 md:grid-cols-2 lg:grid-cols-3">
          {testimonials.map((item) => (
            <figure class="panel">
              <blockquote class="text-sm leading-relaxed text-txt-300">{item.text}</blockquote>
              <figcaption class="panel-foot border-t border-line-600">
                <span class="block font-mono text-xs text-txt-100">{item.author}</span>
                <span class="mt-1 block truncate font-mono text-xs text-txt-500">{item.project}</span>
              </figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>
  )
}
