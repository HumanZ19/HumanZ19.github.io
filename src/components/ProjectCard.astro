---
import type { Lang } from '@types';
import type { Project } from '@types';
import { t, localized, localizedArray } from '@utils/i18n';
import { getProjectFilterCategory } from '@utils/helpers';

interface Props {
  project: Project;
  lang: Lang;
  index: number;
}
const { project, lang, index } = Astro.props;

const category = localized(project.category, lang);
const description = localized(project.description, lang);
const status = localized(project.status, lang);
const client = localized(project.client, lang);
const features = localizedArray(project.features, lang);
const filterCategory = getProjectFilterCategory(project);

// Numero de registre : 001, 002, ... C'est la signature de la page.
const ref = String(index + 1).padStart(3, '0');

// [SPEC 5.1] Le nombre de pastilles affichees est borne pour que la rangee
// tienne sur deux lignes au maximum, y compris sur mobile. Le reliquat est
// resume par un compteur, jamais par une pastille a rallonge.
const VISIBLE_TAGS = 5;
const shown = project.technologies.slice(0, VISIBLE_TAGS);
const remaining = project.technologies.length - shown.length;
---

<article class="panel" data-category={filterCategory} data-id={project.id}>
  <!-- En-tete de registre : reference et date, sur une seule ligne -->
  <header class="flex items-baseline justify-between gap-4 border-b border-line-600 pb-3">
    <span class="font-mono text-xs tracking-[0.08em] text-signal">{ref} /</span>
    <span class="truncate font-mono text-xs text-txt-500">{project.date}</span>
  </header>

  <h3 class="clamp-2 mt-5 font-display text-xl font-semibold text-txt-100">
    {project.title}
  </h3>

  <p class="mt-2 truncate font-mono text-xs uppercase tracking-[0.08em] text-txt-500">
    {category}
  </p>

  <p class="clamp-3 mt-4 text-sm text-txt-300">
    {description}
  </p>

  {
    features.length > 0 && (
      <details class="group mt-4">
        <summary class="link-signal inline-block cursor-pointer list-none select-none">
          {t('projects.show_features', lang)}
        </summary>
        <ul class="rail mt-4 space-y-2">
          {features.map((f) => (
            <li class="rail-mark relative text-sm text-txt-300">{f}</li>
          ))}
        </ul>
      </details>
    )
  }

  <!-- [SPEC 5.3] pied pousse en bas : les pieds de cards s'alignent -->
  <div class="panel-foot">
    <div class="tag-row">
      {shown.map((tech) => <span class="tag">{tech}</span>)}
      {remaining > 0 && <span class="tag text-txt-500">+{remaining}</span>}
    </div>

    <dl class="mt-5 space-y-1 border-t border-line-600 pt-4">
      <div class="flex items-baseline gap-3">
        <dt class="label flex-shrink-0">{lang === 'fr' ? 'Client' : 'Client'}</dt>
        <dd class="truncate font-mono text-xs text-txt-300">{client}</dd>
      </div>
      <div class="flex items-baseline gap-3">
        <dt class="label flex-shrink-0">{lang === 'fr' ? 'Etat' : 'Status'}</dt>
        <dd class="truncate font-mono text-xs text-txt-300">{status}</dd>
      </div>
    </dl>

    {
      project.url && (
        <a
          href={project.url}
          target="_blank"
          rel="noopener noreferrer"
          class="link-signal mt-4 inline-block"
        >
          {lang === 'fr' ? 'Voir le site' : 'Visit site'}
        </a>
      )
    }
  </div>
</article>
