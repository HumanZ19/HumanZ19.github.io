---
import type { Lang } from '@types';
import type { Projects } from '@types';
import { t } from '@utils/i18n';
import { getProjectFilterCategory } from '@utils/helpers';

interface Props {
  projects: Projects;
  lang: Lang;
}
const { projects, lang } = Astro.props;

const countBy = (id: string) =>
  id === 'all'
    ? projects.projects.length
    : projects.projects.filter((p) => getProjectFilterCategory(p) === id).length;

const filters = [
  { id: 'all', label: t('projects.filter_all', lang) },
  { id: 'recent', label: t('projects.filter_recent', lang) },
  { id: 'institutional', label: t('projects.filter_institutional', lang) },
  { id: 'pioneer', label: t('projects.filter_pioneer', lang) },
].map((f) => ({ ...f, count: countBy(f.id) }));
---

<div
  id="project-filters"
  class="mb-10 flex flex-wrap items-center gap-2 border-b border-line-600 pb-6"
  role="group"
  aria-label={t('projects.subtitle', lang)}
>
  {
    filters.map((filter, i) => (
      <button
        type="button"
        data-filter={filter.id}
        aria-pressed={i === 0 ? 'true' : 'false'}
        class="filter-btn inline-flex h-9 items-center gap-2 whitespace-nowrap border border-line-600 px-4 font-mono text-xs uppercase tracking-[0.08em] text-txt-500 transition-colors hover:border-txt-500 hover:text-txt-100 aria-pressed:border-signal aria-pressed:bg-signal aria-pressed:text-ink-900"
      >
        {filter.label}
        <span class="filter-count opacity-60">{filter.count}</span>
      </button>
    ))
  }
</div>

<script>
  const filterBtns = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
  // Les cards sont enfants directs de la grille : on masque la card elle-meme,
  // surtout pas son parent, qui est la grille entiere.
  const cards = document.querySelectorAll<HTMLElement>('#projects-grid [data-category]');

  filterBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const filter = btn.dataset.filter!;

      filterBtns.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));

      cards.forEach((card) => {
        const visible = filter === 'all' || card.dataset.category === filter;
        card.hidden = !visible;
      });
    });
  });
</script>

<style>
  /* `hidden` seul ne suffit pas face a display:flex de la card. */
  #projects-grid [data-category][hidden] {
    display: none;
  }
</style>
