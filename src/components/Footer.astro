---
import type { Lang } from '@types';
import type { Profile } from '@types';
import { t } from '@utils/i18n';

interface Props {
  lang: Lang;
  profile?: Profile;
}
const { lang } = Astro.props;
const year = new Date().getFullYear();

const channels = [
  {
    label: t('contact.email_label', lang),
    value: 'aithammoukarim@gmail.com',
    href: 'mailto:aithammoukarim@gmail.com',
  },
  {
    label: t('contact.phone_label', lang),
    value: '+212 6 15 80 76 63',
    href: 'tel:+212615807663',
  },
  {
    label: t('contact.linkedin_label', lang),
    value: 'karimaithammou',
    href: 'https://linkedin.com/in/karimaithammou',
  },
  {
    label: 'GitHub',
    value: 'HumanZ19',
    href: 'https://github.com/HumanZ19',
  },
];
---

<footer class="print:hidden">
  <section id="contact" class="section">
    <div class="shell">
      <div class="section-head">
        <span class="section-index">04</span>
        <h2 class="section-title">{t('contact.cta_heading', lang)}</h2>
      </div>

      <p class="mb-10 max-w-2xl text-sm text-txt-300">{t('contact.cta_desc', lang)}</p>

      <!-- Canaux en fiche technique : libelle, valeur, une ligne chacun -->
      <dl class="grid gap-x-8 gap-y-6 sm:grid-cols-2 lg:grid-cols-4">
        {
          channels.map((c) => (
            <div class="border-t border-line-500 pt-3">
              <dt class="label">{c.label}</dt>
              <dd class="mt-1">
                <a
                  href={c.href}
                  target={c.href.startsWith('http') ? '_blank' : undefined}
                  rel={c.href.startsWith('http') ? 'noopener noreferrer' : undefined}
                  class="block truncate font-mono text-sm text-txt-100 hover:text-signal"
                >
                  {c.value}
                </a>
              </dd>
            </div>
          ))
        }
      </dl>

      <a href="mailto:aithammoukarim@gmail.com" class="btn btn-primary mt-10">
        {t('contact.cta_btn', lang)}
      </a>
    </div>
  </section>

  <div class="border-t border-line-600 bg-ink-800">
    <div class="shell flex flex-col gap-3 py-6 font-mono text-xs text-txt-500 sm:flex-row sm:items-center sm:justify-between">
      <span class="truncate">&copy; {year} Karim AIT HAMMOU. {t('footer.rights', lang)}.</span>
      <span class="truncate">
        {t('footer.built_with', lang)}
        <a
          href="https://astro.build"
          target="_blank"
          rel="noopener noreferrer"
          class="text-txt-300 hover:text-signal">Astro</a
        >
      </span>
      <a href="#hero" class="text-txt-300 hover:text-signal">{t('footer.back_to_top', lang)}</a>
    </div>
  </div>
</footer>
