---
import type { Lang } from '@types';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

const label = lang === 'fr' ? 'Basculer le theme clair ou sombre' : 'Toggle light or dark theme';
---

<!--
  Bascule de theme dans le langage de la direction : deux etats nommes, pas
  une icone soleil/lune. Le libelle actif est marque en ambre, comme le
  selecteur de langue, pour que les deux commandes se lisent pareil.
-->
<button
  id="theme-toggle"
  type="button"
  aria-label={label}
  title={label}
  class="flex h-8 items-center gap-1 border border-line-600 px-2 font-mono text-xs uppercase tracking-[0.08em] text-txt-500 transition-colors hover:border-txt-500 hover:text-txt-100"
>
  <span data-theme-mark="dark">DARK</span>
  <span aria-hidden="true" class="text-line-500">/</span>
  <span data-theme-mark="light">LIGHT</span>
</button>

<script>
  const KEY = 'theme';
  const root = document.documentElement;
  const btn = document.getElementById('theme-toggle');

  function paint(theme: string) {
    root.classList.toggle('light', theme === 'light');
    document.querySelectorAll<HTMLElement>('[data-theme-mark]').forEach((el) => {
      el.classList.toggle('text-signal', el.dataset.themeMark === theme);
    });
  }

  // Etat initial : la classe a deja ete posee avant le premier rendu par le
  // script inline du layout. On se contente ici de marquer le libelle actif.
  paint(root.classList.contains('light') ? 'light' : 'dark');

  btn?.addEventListener('click', () => {
    const next = root.classList.contains('light') ? 'dark' : 'light';
    paint(next);
    try {
      localStorage.setItem(KEY, next);
    } catch {
      /* navigation privee : la preference ne survit pas a la session */
    }
  });
</script>
