---
import type { Lang } from '@types';
import type { Profile } from '@types';
import { t, localized } from '@utils/i18n';

interface Props {
  profile: Profile;
  lang: Lang;
}
const { profile, lang } = Astro.props;
const { basics } = profile;
const summary = localized(basics.summary, lang);
const availability = localized(basics.availability, lang);

// Bloc d'identification en donnees brutes, lisible comme une fiche technique.
const facts = [
  {
    label: lang === 'fr' ? 'Base' : 'Based in',
    value: `${basics.location.city}, ${localized(basics.location.country, lang)}`,
  },
  { label: t('about.availability_label', lang), value: availability },
  {
    label: lang === 'fr' ? 'Experience' : 'Experience',
    value: `${basics.yearsOfExperience} ${lang === 'fr' ? 'ans' : 'years'}`,
  },
];

const highlights = [
  { title: t('about.highlight_leadership', lang), desc: t('about.highlight_leadership_desc', lang) },
  { title: t('about.highlight_innovation', lang), desc: t('about.highlight_innovation_desc', lang) },
  { title: t('about.highlight_multisector', lang), desc: t('about.highlight_multisector_desc', lang) },
];
---

<section id="about" class="section border-b border-line-600">
  <div class="shell">
    <div class="section-head">
      <span class="section-index">00</span>
      <h2 class="section-title">{t('sections.about', lang)}</h2>
      <span class="section-note">{t('about.subtitle', lang)}</span>
    </div>

    <div class="grid gap-12 lg:grid-cols-3">
      <!-- Resume -->
      <div class="lg:col-span-2">
        <p class="max-w-3xl text-base text-txt-300">{summary}</p>

        <div class="mt-10 grid gap-6 sm:grid-cols-3">
          {
            highlights.map((h) => (
              <div class="border-t border-line-500 pt-4">
                <h3 class="font-display text-lg font-semibold text-txt-100">{h.title}</h3>
                <p class="mt-2 text-sm text-txt-500">{h.desc}</p>
              </div>
            ))
          }
        </div>
      </div>

      <!-- Fiche technique -->
      <aside class="space-y-8">
        <dl class="space-y-4">
          {
            facts.map((f) => (
              <div class="border-t border-line-600 pt-3">
                <dt class="label">{f.label}</dt>
                <dd class="mt-1 font-mono text-sm text-txt-100">{f.value}</dd>
              </div>
            ))
          }
        </dl>

        <div>
          <p class="label mb-3">{t('about.languages_label', lang)}</p>
          <div class="tag-row">
            {
              profile.languages.map((l) => (
                <span class="tag">
                  {localized(l.language, lang)} / {localized(l.fluency, lang)}
                </span>
              ))
            }
          </div>
        </div>

        <div>
          <p class="label mb-3">Soft skills</p>
          <ul class="rail space-y-2">
            {
              profile.skills.soft[lang].map((skill) => (
                <li class="rail-mark relative text-sm text-txt-300">{skill}</li>
              ))
            }
          </ul>
        </div>
      </aside>
    </div>
  </div>
</section>
