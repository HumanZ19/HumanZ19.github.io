---
import type { Lang } from '@types';
import type { Profile } from '@types';
import { t, localized } from '@utils/i18n';

interface Props {
  profile: Profile;
  lang: Lang;
}
const { profile, lang } = Astro.props;
const { basics } = profile;
const label = localized(basics.label, lang);
const availability = localized(basics.availability, lang);
const stats = basics.heroStats;

// Les metriques sont presentees comme des lectures d'instrument : valeur large,
// unite discrete, filet au-dessus. Aucune card arrondie centree.
const readouts = [
  { value: `${basics.yearsOfExperience}`, unit: t('hero.stats_years', lang) },
  stats?.projectsCount ? { value: `${stats.projectsCount}`, unit: t('hero.stats_projects', lang) } : null,
  stats?.maxTeamManaged ? { value: `${stats.maxTeamManaged}`, unit: t('hero.stats_team', lang) } : null,
  stats?.countriesDeployed ? { value: `${stats.countriesDeployed}`, unit: t('hero.stats_countries', lang) } : null,
  stats?.legislationsCompliance
    ? { value: `${stats.legislationsCompliance}`, unit: t('hero.stats_legislations', lang) }
    : null,
].filter((r): r is { value: string; unit: string } => r !== null);
---

<section id="hero" class="relative overflow-hidden border-b border-line-600">
  <!-- Trame technique de fond. Purement decorative, en retrait, sans halo. -->
  <div class="grid-lines pointer-events-none absolute inset-0 opacity-[0.35]" aria-hidden="true"></div>
  <div
    class="pointer-events-none absolute inset-x-0 bottom-0 h-40 bg-gradient-to-t from-ink-900 to-transparent"
    aria-hidden="true"
  >
  </div>

  <div class="shell relative py-20 md:py-28">
    <!-- Ligne d'identification -->
    <p class="reveal label mb-6" style="animation-delay:0ms">
      <span class="text-signal">//</span>
      {basics.location.city}, {localized(basics.location.country, lang)}
    </p>

    <h1
      class="reveal font-display text-4xl font-bold uppercase leading-none tracking-tight text-txt-100 md:text-5xl"
      style="animation-delay:60ms"
    >
      {basics.name}
    </h1>

    <p
      class="reveal mt-4 max-w-3xl font-mono text-sm uppercase tracking-[0.08em] text-signal md:text-base"
      style="animation-delay:120ms"
    >
      {label}
    </p>

    <p class="reveal mt-8 max-w-2xl text-base text-txt-300" style="animation-delay:180ms">
      {availability}
    </p>

    <!-- Actions -->
    <div class="reveal mt-10 flex flex-wrap items-center gap-3" style="animation-delay:240ms">
      <a href="/cv-print/" target="_blank" rel="noopener" class="btn btn-primary">
        {t('hero.cta_cv', lang)}
      </a>
      <a href="#contact" class="btn btn-ghost">
        {t('hero.cta_contact', lang)}
      </a>
      {
        basics.profiles.map((p) => (
          <a
            href={p.url}
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-ghost"
            aria-label={p.network}
          >
            {p.network}
          </a>
        ))
      }
    </div>

    <!-- Lectures d'instrument. Grille stricte, hauteurs egales par ligne. -->
    {
      readouts.length > 0 && (
        <div
          class="reveal mt-16 grid grid-cols-2 gap-x-6 gap-y-8 sm:grid-cols-3 lg:grid-cols-5"
          style="animation-delay:300ms"
        >
          {readouts.map((r) => (
            <div class="readout">
              <span class="readout-value">{r.value}</span>
              <span class="readout-unit">{r.unit}</span>
            </div>
          ))}
        </div>
      )
    }
  </div>
</section>
