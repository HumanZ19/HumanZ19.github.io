---
import type { Lang } from '@types';
import type { Projects } from '@types';
import { t } from '@utils/i18n';
import ProjectCard from './ProjectCard.astro';
import ProjectFilters from './ProjectFilters.astro';

interface Props {
  projects: Projects;
  lang: Lang;
}
const { projects, lang } = Astro.props;
const total = projects.projects.length;
---

<section id="projects" class="section border-b border-line-600">
  <div class="shell">
    <div class="section-head">
      <span class="section-index">02</span>
      <h2 class="section-title">{t('sections.projects', lang)}</h2>
      <span class="section-note">{total} {lang === 'fr' ? 'entrees' : 'entries'}</span>
    </div>

    <p class="mb-10 max-w-2xl text-sm text-txt-300">
      {t('projects.subtitle', lang)}
    </p>

    <ProjectFilters projects={projects} lang={lang} />

    <!--
      [SPEC 5.3] grid + align-items:stretch egalise les hauteurs par rangee
      sans aucun calcul JavaScript. Chaque card est elle-meme un flex column
      dont le pied est pousse en bas, ce qui aligne aussi les pieds entre eux.
    -->
    <div id="projects-grid" class="grid items-stretch gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        projects.projects.map((project, i) => (
          <ProjectCard project={project} lang={lang} index={i} />
        ))
      }
    </div>
  </div>
</section>
