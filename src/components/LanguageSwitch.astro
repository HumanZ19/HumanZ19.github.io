---
import type { Lang } from '@types';
import { t, getAlternateUrl } from '@utils/i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const targetLang: Lang = lang === 'fr' ? 'en' : 'fr';
const label = lang === 'fr' ? t('lang.switch_to_en', lang) : t('lang.switch_to_fr', lang);
const href = getAlternateUrl(Astro.url, targetLang);
---

<!-- Les drapeaux emoji sont proscrits (docs/DESIGN-SYSTEM.md section 1) :
     un drapeau designe un pays, pas une langue. Deux codes suffisent. -->
<a
  href={href}
  aria-label={label}
  title={label}
  hreflang={targetLang}
  class="flex h-8 items-center gap-1 border border-line-600 px-2 font-mono text-xs uppercase tracking-[0.08em] text-txt-500 transition-colors hover:border-txt-500 hover:text-txt-100"
>
  <span class={lang === 'fr' ? 'text-signal' : ''}>FR</span>
  <span aria-hidden="true" class="text-line-500">/</span>
  <span class={lang === 'en' ? 'text-signal' : ''}>EN</span>
</a>
