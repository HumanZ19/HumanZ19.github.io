---
import SEOHead from '@components/SEOHead.astro';
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';
import '@styles/global.css';
import type { Lang } from '@types';

interface Props {
  title: string;
  description: string;
  lang: Lang;
  canonicalUrl: string;
  alternateUrl: string;
  ogImage?: string | undefined;
  /** Localisation affichee dans la barre de statut. Vient toujours de
   *  profile.json : aucun contenu n'est ecrit en dur dans un composant. */
  statusLocation?: string | undefined;
}

const { title, description, lang, canonicalUrl, alternateUrl, ogImage, statusLocation } =
  Astro.props;

// Date de derniere generation, affichee dans la barre de statut. Elle rend la
// barre honnete : elle affiche un fait, pas une decoration.
const buildDate = new Date().toISOString().slice(0, 10);
---

<!doctype html>
<!-- Theme sombre unique et assume : la direction "salle de controle" n'a pas
     d'equivalent clair credible. La classe dark est donc posee en dur, ce qui
     preserve les variantes dark: des composants non encore repris. -->
<html lang={lang} class="dark scroll-smooth">
  <head>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans+Condensed:wght@600;700&family=IBM+Plex+Sans:wght@400;500&display=swap"
      rel="stylesheet"
    />

    <SEOHead
      title={title}
      description={description}
      lang={lang}
      canonicalUrl={canonicalUrl}
      alternateUrl={alternateUrl}
      ogImage={ogImage}
    />
  </head>

  <body class="bg-ink-900 text-txt-100 font-sans antialiased">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-20 focus:bg-signal focus:px-4 focus:py-2 focus:font-mono focus:text-xs focus:text-ink-900"
    >
      {lang === 'fr' ? 'Aller au contenu' : 'Skip to content'}
    </a>

    <!-- Barre de statut : registre de supervision, informations reelles -->
    <div class="border-b border-line-600 bg-ink-800">
      <div class="shell flex h-8 items-center justify-between font-mono text-xs text-txt-500">
        <span class="flex items-center gap-2 truncate">
          <span class="h-1.5 w-1.5 flex-shrink-0 bg-signal" aria-hidden="true"></span>
          {statusLocation && <span class="truncate">{statusLocation}</span>}
        </span>
        <span class="hidden truncate sm:block">
          {lang === 'fr' ? 'MAJ' : 'UPD'}
          {buildDate}
        </span>
      </div>
    </div>

    <Header lang={lang} />

    <main id="main-content">
      <slot />
    </main>

    <Footer lang={lang} />
  </body>
</html>
